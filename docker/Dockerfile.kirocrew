ARG BASE_IMAGE=ghcr.io/kirodotdev/kirocrew@sha256:5fa64503c111cfaf25e78a0fdcd6106f2b5b033b9043bf216cfac8ac456ada56
FROM ${BASE_IMAGE}

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        gnupg \
        openssh-client \
        libreoffice \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcups2 \
        libnspr4 \
        libnss3 \
        libxcomposite1 \
        libxdamage1 \
    && install -d -m 0755 /usr/share/keyrings \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor --yes -o /usr/share/keyrings/cloud.google.gpg \
    && printf '%s\n' \
        'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main' \
        > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        google-cloud-cli \
        google-cloud-cli-gke-gcloud-auth-plugin \
        kubectl \
    && gcloud --version \
    && kubectl version --client \
    && gke-gcloud-auth-plugin --version \
    && rm -rf /var/lib/apt/lists/*

# Upstream now bounds the `initialize` handshake natively:
# constants.INITIALIZE_TIMEOUT_SECS feeds _INITIALIZE_TIMEOUT in
# acp/runtime_spawn_launch.py, which passes it to _send_and_await. Keep the
# operator knob by making that shared constant env-driven; the subagent
# startup watchdog reads the same constant, so one override keeps both
# budgets in step. The spawn module check fails the build if upstream stops
# routing the constant into the handshake.
RUN python3 - <<'PY'
from pathlib import Path

path = Path('/usr/local/lib/python3.12/site-packages/kiro_crew/constants.py')
text = path.read_text()
old = 'INITIALIZE_TIMEOUT_SECS = 90.0\n'
new = 'INITIALIZE_TIMEOUT_SECS = float(os.environ.get("KIROCREW_ACP_INIT_TIMEOUT_SECS", "120"))\n'
if text.count(old) != 1:
    raise SystemExit(f'Expected initialize timeout constant was not found in {path}')
if '\nimport os\n' not in text:
    raise SystemExit(f'Expected os import was not found in {path}')
path.write_text(text.replace(old, new, 1))

spawn_path = Path('/usr/local/lib/python3.12/site-packages/kiro_crew/acp/runtime_spawn_launch.py')
spawn_text = spawn_path.read_text()
if '_INITIALIZE_TIMEOUT = INITIALIZE_TIMEOUT_SECS' not in spawn_text \
        or 'timeout=timeout' not in spawn_text:
    raise SystemExit(f'Expected initialize timeout binding was not found in {spawn_path}')

# Allow ACP shells to use the instance's gcloud configuration. Keep all other
# credential paths protected by the sandbox launcher.
provider_path = Path('/usr/local/lib/python3.12/site-packages/kiro_crew/dashboard/source_providers/runner.py')
provider_text = provider_path.read_text()
provider_old = '_COMMAND_TIMEOUT_SECS = 30\n'
provider_new = '_COMMAND_TIMEOUT_SECS = float(os.environ.get("KIROCREW_SOURCE_PROVIDER_TIMEOUT_SECS", "120"))\n'
if provider_text.count(provider_old) != 1:
    raise SystemExit(f'Expected source provider timeout was not found in {provider_path}')
provider_path.write_text(provider_text.replace(provider_old, provider_new, 1))

sandbox_path = Path('/usr/local/lib/python3.12/site-packages/kiro_crew/sandbox_tiers.py')
sandbox_text = sandbox_path.read_text()
needle = '    ".config/gcloud",\n'
expected = 3
if sandbox_text.count(needle) != expected:
    raise SystemExit(f'Expected {expected} gcloud sandbox entries in {sandbox_path}')
sandbox_path.write_text(sandbox_text.replace(needle, '', expected))
PY

USER kirocrew
