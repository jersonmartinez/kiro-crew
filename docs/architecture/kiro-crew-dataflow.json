    "viewBox": [1080, 900],
    "quality_profile": "showcase",
    "views": [
      { "id": "project-flow", "label": "Project flow", "focus": ["host", "mount", "workspace", "agent", "result"], "note": "Follow project files from the Windows host into an agent prompt and result." },
