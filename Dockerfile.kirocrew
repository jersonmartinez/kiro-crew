ARG BASE_IMAGE=ghcr.io/kirodotdev/kirocrew@sha256:368ff37d3d3cf82d972eeb15fba1128fc09cb78b0004ddd19c39e9d3b7a9669a
FROM ${BASE_IMAGE}

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        gnupg \
        libreoffice \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcups2 \
        libnspr4 \
        libnss3 \
        libxcomposite1 \
        libxdamage1 \
    && install -d -m 0755 /usr/share/keyrings \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor --yes -o /usr/share/keyrings/cloud.google.gpg \
    && printf '%s\n' \
        'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main' \
        > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        google-cloud-cli \
        google-cloud-sdk-gke-gcloud-auth-plugin \
        kubectl \
    && gcloud --version \
    && kubectl version --client \
    && gke-gcloud-auth-plugin --version \
    && rm -rf /var/lib/apt/lists/*

# The constant alone is inert: the `initialize` handshake calls
# _send_and_await without a timeout, falling back to _REQUEST_TIMEOUT (30s).
# Pass the (now env-driven) _INIT_TIMEOUT at the call site so the budget
# actually applies to the handshake.
RUN python3 - <<'PY'
from pathlib import Path

path = Path('/usr/local/lib/python3.12/site-packages/kiro_crew/acp/runtime.py')
text = path.read_text()
old = '_INIT_TIMEOUT = 30.0'
new = '_INIT_TIMEOUT = float(os.environ.get("KIROCREW_ACP_INIT_TIMEOUT_SECS", "120"))'
if old not in text:
    raise SystemExit(f'Expected ACP timeout constant was not found in {path}')
text = text.replace(old, new, 1)
call_old = '                },\n            )\n            self._can_load_session = bool('
call_new = '                },\n                timeout=_INIT_TIMEOUT,\n            )\n            self._can_load_session = bool('
if call_old not in text:
    raise SystemExit(f'Expected initialize call site was not found in {path}')
path.write_text(text.replace(call_old, call_new, 1))

# Allow ACP shells to use the instance's gcloud configuration. Keep all other
# credential paths protected by the sandbox launcher.
sandbox_path = Path('/usr/local/lib/python3.12/site-packages/kiro_crew/sandbox.py')
sandbox_text = sandbox_path.read_text()
needle = '    ".config/gcloud",\n'
expected = 3
if sandbox_text.count(needle) != expected:
    raise SystemExit(f'Expected {expected} gcloud sandbox entries in {sandbox_path}')
sandbox_path.write_text(sandbox_text.replace(needle, '', expected))
PY

USER kirocrew
