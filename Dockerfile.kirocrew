ARG BASE_IMAGE=ghcr.io/kirodotdev/kirocrew:stable
FROM ${BASE_IMAGE}

USER root

RUN python3 - <<'PY'
from pathlib import Path

path = Path('/usr/local/lib/python3.12/site-packages/kiro_crew/acp/runtime.py')
text = path.read_text()
old = '_INIT_TIMEOUT = 30.0'
new = '_INIT_TIMEOUT = float(os.environ.get("KIROCREW_ACP_INIT_TIMEOUT_SECS", "120"))'
if old not in text:
    raise SystemExit(f'Expected ACP timeout constant was not found in {path}')
text = text.replace(old, new, 1)

# The constant alone is inert: the `initialize` handshake calls
# _send_and_await without a timeout, falling back to _REQUEST_TIMEOUT (30s).
# Pass the (now env-driven) _INIT_TIMEOUT at the call site so the budget
# actually applies to the handshake.
call_old = '                },\n            )\n            self._can_load_session = bool('
call_new = '                },\n                timeout=_INIT_TIMEOUT,\n            )\n            self._can_load_session = bool('
if call_old not in text:
    raise SystemExit(f'Expected initialize call site was not found in {path}')
text = text.replace(call_old, call_new, 1)

path.write_text(text)
PY

USER kirocrew
