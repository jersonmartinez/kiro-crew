# Directory containing the projects KiroCrew should access.
# WSL2-native paths (e.g. /home/your-user/repos) perform better than /mnt/c/...
PROJECTS_BASE=./projects

# Timezone for KiroCrew's scheduling and log timestamps.
TZ=America/Managua

# KiroCrew base image. Keep this digest pinned for reproducible builds.
# Update it deliberately when upgrading the upstream runtime.
KIROCREW_IMAGE=ghcr.io/kirodotdev/kirocrew@sha256:368ff37d3d3cf82d972eeb15fba1128fc09cb78b0004ddd19c39e9d3b7a9669a

# Local runtime image built from Dockerfile.kirocrew.
KIROCREW_RUNTIME_IMAGE=kirocrew-local:latest

# ACP initialize handshake budget. The runtime patch defaults to 120 seconds
# and applies it at the initialize call site (see ADR-006/ADR-008). If the
# error message shows this configured value, the handshake is genuinely slow —
# check host CPU contention with `docker stats`.
KIROCREW_ACP_INIT_TIMEOUT_SECS=120

# Kiro A and Kiro B dashboard ports (localhost-only).
KIRO_A_PORT=5476
KIRO_B_PORT=5477

# ─── Project tree masking (ADR-009) ──────────────────────────────────────────
# Directory traversal over a Windows bind mount costs ~1ms per entry, so a repo
# with a large node_modules makes any project-tree walk take minutes and starves
# the gateway event loop (surfacing as `Request initialize timed out`).
# `make masks` scans PROJECTS_BASE and generates docker-compose.override.yml,
# masking each of these directories with an empty tmpfs. Masked directories look
# EMPTY inside the container; .git, build and dist are deliberately left visible.
# Remove a name from this list if the agent must read its real contents.
KIROCREW_MASK_DIRS=node_modules .venv venv vendor target __pycache__ .next .nuxt .docusaurus .cache .pytest_cache .mypy_cache .gradle

# How deep to search for the directories above (repos may be nested one level).
KIROCREW_MASK_MAX_DEPTH=4

# Upper bound for each masked tmpfs. Only consumed if something writes there.
KIROCREW_MASK_TMPFS_SIZE=1g

# ─── GitHub identity per instance (ADR-010) ──────────────────────────────────
# Each instance authenticates as its own GitHub account. gh reads GH_TOKEN on
# every invocation, so there is no `gh auth login` state to lose on restart, and
# the config services write a matching git identity into each home volume.
# Create a fine-grained or classic PAT per account (scopes: repo, workflow,
# read:org) and keep the values in this ignored .env only.
GH_USER_A=
GH_TOKEN_A=
GH_USER_B=
GH_TOKEN_B=

# Optional: override the commit email. Defaults to
# <GH_USER_X>@users.noreply.github.com, which keeps private addresses out of
# commit history.
#GH_EMAIL_A=
#GH_EMAIL_B=

# GID of /var/run/docker.sock. In Docker Desktop + WSL2 this is usually 0.
# Find it with: stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=0

# ─── Kiro Crew resource-safe defaults ────────────────────────────────────────
# Applied by the Kiro A and Kiro B init services into their persistent volumes.
# Lower extraction concurrency prevents Knowledge scans from starving ACP chat.
KIROCREW_KNOWLEDGE_MAX_SOURCES=100
KIROCREW_KNOWLEDGE_EXTRACTION_POOL_SIZE=1
KIROCREW_KNOWLEDGE_FOLDER_CHUNK_BUDGET=25

# ─── Project Compose Paths (optional) ────────────────────────────────────────
# Define the path (relative to PROJECTS_BASE) to each project's compose file.
# Used by `make project-up NAME=<project>`. Defaults to <project>/infra/docker/compose.yml.
# DEMO_APP_COMPOSE=demo-app/infra/docker/compose.yml

# Compose profile used by project-up/project-down.
PROJECT_PROFILE=dev
