# Set this to the directory containing the projects KiroCrew should access.
# WSL2-native paths (for example /home/your-user/repos) usually perform better.
PROJECTS_BASE=./projects
TZ=America/Managua
KIROCREW_IMAGE=ghcr.io/kirodotdev/kirocrew:stable
DASHBOARD_PORT=5476
# Use `stat -c '%g' /var/run/docker.sock` in WSL2/Linux when the socket GID differs.
DOCKER_SOCKET_GID=0
